# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/neuro_dispatch
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=neuro_dispatch

# Redis
REDIS_URL=redis://localhost:6379/0

# Application
APP_ENV=development
LOG_LEVEL=INFO
DEBUG=true

# API
API_HOST=0.0.0.0
API_PORT=8000

# H3 Configuration (city center - Moscow as default)
DEFAULT_CITY_LAT=55.7558
DEFAULT_CITY_LNG=37.6173
H3_RESOLUTION=8

# Feature flags
ENABLE_SURGE_PRICING=true
ENABLE_ML_PREDICTIONS=false

